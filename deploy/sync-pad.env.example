# Sync Pad environment configuration
# Copy to /etc/sync-pad/env and edit before starting the systemd service.

SYNC_PAD_PORT=:8080
SYNC_PAD_WEB_DIR=/var/www/sync-pad
SYNC_PAD_BASE_PATH=/s

# Production: explicitly list your public domain(s).
SYNC_PAD_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Connection & limit tuning
# SYNC_PAD_MAX_CONNECTIONS=500
# SYNC_PAD_ROOM_TTL=30m
# SYNC_PAD_PING_PERIOD=3s
# SYNC_PAD_PONG_WAIT=6s
# SYNC_PAD_RATE_LIMIT_CONNS=10
# SYNC_PAD_RATE_LIMIT_MESSAGES=100
